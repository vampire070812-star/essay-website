# ============================================================
# 大模型 API 配置（复制本文件为 .env 后填写）
#   Windows 命令行复制：  copy .env.example .env
# 也可以不建本文件，直接在网页右上角“AI 设置”里填写。
# 接口要求：兼容 OpenAI 的 /chat/completions 协议。
# ============================================================

# API Key（必填，在对应服务商开放平台申请）
LLM_API_KEY=sk-在这里填入你的密钥

# 接口地址 BASE_URL 与模型名 MODEL（下面任选一家，取消注释即可）

# ---- DeepSeek（推荐，注册即送额度，价格低；https://platform.deepseek.com）----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 智谱 GLM（https://open.bigmodel.cn）----
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ---- 阿里通义千问 DashScope（https://dashscope.console.aliyun.com）----
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ---- 月之暗面 Moonshot Kimi（https://platform.moonshot.cn）----
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# ---- OpenAI（需要可直连的网络环境）----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ---- 其它 OpenAI 兼容服务（本地 Ollama / 第三方中转等）----
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# ============================================================
# 账号与每日配额（可选，不配置即用下面的默认值）
#   使用服务端 Key 时需登录账号；浏览器自带 Key 的用户不受限制。
# ============================================================

# 每个账号每天可用的批改次数（默认 30，设为 0 表示不限）
# GRADES_PER_DAY=30

# 每个账号每天可用的 AI 审题次数（默认 60，设为 0 表示不限）
# ANALYZES_PER_DAY=60

# 设为 1 可关闭“用服务端 Key 必须登录”的限制（任何人可用，注意额度安全）
# ALLOW_ANON_AI=0

# ============================================================
# 阿里云短信验证码登录（可选；4 项全部填写后自动开通登录弹窗中的
# “手机验证码”入口，未配置时该入口自动隐藏，不影响账号密码登录）
#
# 开通步骤：
#   1. 注册阿里云并完成个人实名：https://www.aliyun.com
#   2. 开通“短信服务”，创建 AccessKey（建议用 RAM 子账号，仅授予
#      AliyunDysmsFullAccess），拿到 AccessKey ID / Secret
#   3. 申请短信签名（国内短信通常要求网站已完成 ICP 备案）
#   4. 申请短信模板，模板内容形如：
#      您的验证码为${code}，${分钟}分钟内有效，请勿泄露给他人。
#      （系统实际只传 code；审核通过后拿到模板 CODE，如 SMS_123456789）
#   5. 按条计费（约 0.045 元/条），账户充值后即可发送
#
# 本机/局域网调试：若 4 项均未填，另设 SMS_DEBUG=1，验证码会直接
# 通过接口返回并在页面自动填入，不会真正发短信。切勿在公网开启。
# ============================================================

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# SMS_DEBUG=1
